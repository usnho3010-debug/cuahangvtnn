# Set these in Netlify -> Site configuration -> Environment variables
# Never commit real secrets or customer data.
APPS_SCRIPT_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
API_SHARED_SECRET=REPLACE_WITH_RANDOM_SHARED_SECRET
SESSION_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
ADMIN_EMAILS=owner@example.com
TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
TURNSTILE_SECRET=YOUR_TURNSTILE_SECRET
# Optional stronger allowlist: ADMIN_GOOGLE_SUBS=google-id-1,google-id-2
